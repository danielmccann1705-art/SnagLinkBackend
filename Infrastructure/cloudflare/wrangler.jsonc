{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snaglist-backend-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  // Auth and contractor tokens occur in URL paths. Do not persist invocation logs.
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "snaglist-api-staging",
      "workers_dev": true,
      // Additive hostname; existing emitted links retain workers.dev until the
      // staging origin configuration and native association checks are complete.
      "routes": [{ "pattern": "staging-api.usesnaglist.com", "custom_domain": true }],
      "vars": {
        "STAGING_ENABLED": "false",
        "STAGING_PLATFORM_ENABLED": "false",
        "STAGING_DATABASE_HOST": "ep-bitter-wave-zacpbrh7.c-2.eu-west-2.aws.neon.tech",
        "STAGING_EMAIL_ENABLED": "false",
        "EMAIL_ALLOWED_RECIPIENTS": "danielmccann1705@gmail.com",
        "EMAIL_FROM": "Snaglist <notifications@mail.snaglist.dev>",
        "BASE_URL": "https://snaglist-api-staging.danielmccann1705.workers.dev",
        "MAGIC_LINK_BASE_URL": "https://snaglist-api-staging.danielmccann1705.workers.dev",
        "R2_ACCOUNT_ID": "387d49014cd0d45f9e6434196ab513c0",
        "R2_BUCKET_NAME": "snaglist-staging-uploads",
        "R2_PUBLIC_URL": ""
      },
      "containers": [{
        "class_name": "SnaglistBackend",
        "image": "../../Dockerfile",
        "image_build_context": "../..",
        "instance_type": "basic",
        "max_instances": 1,
        "constraints": { "regions": ["WEUR"] },
        "observability": { "logs": { "enabled": false } }
      }],
      "durable_objects": {
        "bindings": [{ "name": "BACKEND", "class_name": "SnaglistBackend" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SnaglistBackend"] }]
    }
  }
}
