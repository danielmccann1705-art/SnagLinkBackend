# Staging environment — copy to `.env.staging` on the Hetzner VPS at /home/snaglist/staging/
# These values must differ from production (separate DB, separate secrets).

# Database — internal to the staging compose network (service name `db`).
DATABASE_URL=postgresql://snaglist:CHANGE_ME@db:5432/snaglist_staging
DATABASE_TLS_DISABLE=true
POSTGRES_DB=snaglist_staging
POSTGRES_USER=snaglist
POSTGRES_PASSWORD=CHANGE_ME

# Use a DIFFERENT secret from production so prod JWTs can't be replayed against staging.
JWT_SECRET=CHANGE_ME_STAGING_SECRET

# Apple Sign In (same app bundle, fine to reuse).
APPLE_APP_ID=com.snaglist.app

# Public web origin used to build magic-link sign-in URLs (B1).
# Must match the AASA-served domain so universal links open the app.
MAGIC_LINK_BASE_URL=https://staging-api.snaglist.dev

# Transactional email (Resend). Leave UNSET on staging to no-op email sending
# (the magic-link request endpoint still returns 204 and stores the token, so iOS can
# integrate end-to-end by reading the token from the DB / logs). Set it only if you want
# real emails delivered from staging.
# RESEND_API_KEY=

LOG_LEVEL=debug
PORT=8080

# B6 feature flags — staging defaults the redesign ON (production leaves this unset → off
# at launch, flipped later via a feature_flags DB row for instant rollout/rollback).
FEATURE_USE_NEW_DESIGN=true
